# Optional public frontend configuration for the historical Vite prototype.
# Copy to .env.local and replace placeholders with your own local values.
#
# IMPORTANT: Every VITE_* variable is bundled into the browser and is public.
# Never put passwords, private analytics credentials or API secrets here.

VITE_API_URL=http://localhost:3000
VITE_BASE_URL=/
VITE_ENABLE_DATA_EXPORT=true
VITE_ANALYTICS_ID=
